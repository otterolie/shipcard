{
  "name": "@otterolie/shipcard",
  "version": "0.1.1",
  "description": "Catch broken social cards before you ship. Local-first preflight for Open Graph, X, LinkedIn, Pinterest, WhatsApp, Telegram, Bluesky, Mastodon and more — score, fixes, and HTML previews. No uploads.",
  "keywords": [
    "open-graph",
    "og",
    "twitter-card",
    "social-preview",
    "meta-tags",
    "og-image",
    "social-cards",
    "link-preview",
    "cli",
    "preflight"
  ],
  "author": "Otter Olie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otterolie/shipcard.git"
  },
  "bugs": {
    "url": "https://github.com/otterolie/shipcard/issues"
  },
  "homepage": "https://github.com/otterolie/shipcard#readme",
  "type": "module",
  "bin": {
    "shipcard": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "image-size": "^2.0.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
