{
  "name": "@otterolie/shipcard",
  "version": "0.3.0",
  "description": "Check Open Graph, Twitter, and social link preview tags before you ship. Audits local builds or live URLs with scoring, fix snippets, and HTML previews.",
  "keywords": [
    "open-graph",
    "og",
    "twitter-card",
    "social-preview",
    "meta-tags",
    "og-image",
    "social-cards",
    "link-preview",
    "cli"
  ],
  "author": "Otter Olie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otterolie/shipcard.git"
  },
  "bugs": {
    "url": "https://github.com/otterolie/shipcard/issues"
  },
  "homepage": "https://github.com/otterolie/shipcard#readme",
  "type": "module",
  "bin": {
    "shipcard": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "htmlparser2": "^10.1.0",
    "image-size": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
